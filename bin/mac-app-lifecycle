#!/usr/bin/env bash
# mac-app-lifecycle - CLI tool for managing macOS application lifecycle
#
# Version: 0.0.13
# Phase 4.1: Core command structure with self-discovery

set -euo pipefail

# =============================================================================
# SELF-DISCOVERY MECHANISM
# =============================================================================

# Get script directory (works from any location)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Calculate repo root
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# Read version from package.json
PACKAGE_JSON="$REPO_ROOT/package.json"
if [[ -f "$PACKAGE_JSON" ]]; then
    VERSION=$(grep '"version"' "$PACKAGE_JSON" | head -1 | sed 's/.*"version": "\([^"]*\)".*/\1/')
else
    VERSION="unknown"
fi

# Set up all paths relative to repo root
CONFIG_DIR="$REPO_ROOT/config"
SCRIPTS_DIR="$REPO_ROOT/scripts"
LOG_DIR="$REPO_ROOT/logs"

# =============================================================================
# VALIDATION FUNCTIONS
# =============================================================================

validate_installation() {
    local errors=()

    # Check if config directory exists
    if [[ ! -d "$CONFIG_DIR" ]]; then
        errors+=("Config directory not found: $CONFIG_DIR")
    fi

    # Check if scripts directory exists
    if [[ ! -d "$SCRIPTS_DIR" ]]; then
        errors+=("Scripts directory not found: $SCRIPTS_DIR")
    fi

    # Check if log directory exists
    if [[ ! -d "$LOG_DIR" ]]; then
        errors+=("Log directory not found: $LOG_DIR")
    fi

    # Check for required scripts
    local required_scripts=(
        "$SCRIPTS_DIR/close-apps/close-apps.sh"
        "$SCRIPTS_DIR/open-apps/open-apps.sh"
    )

    for script in "${required_scripts[@]}"; do
        if [[ ! -x "$script" ]]; then
            errors+=("Required script not executable: $script")
        fi
    done

    # Check macOS version (basic check)
    if ! sw_vers >/dev/null 2>&1; then
        errors+=("This tool requires macOS")
    fi

    if [[ ${#errors[@]} -gt 0 ]]; then
        echo "Installation validation failed:" >&2
        for error in "${errors[@]}"; do
            echo "  - $error" >&2
        done
        return 1
    fi

    return 0
}

# =============================================================================
# HELP & VERSION
# =============================================================================

show_help() {
  cat << EOF
mac-app-lifecycle - Automated macOS Application Lifecycle Manager

USAGE:
  mac-app-lifecycle <command> [options]

COMMANDS:
  close               Close configured applications
  open                Open whitelisted applications
  status              Show launchd agent status
  logs                Display recent logs
  help                Show this help message
  version             Show version information

OPTIONS:
  --now               Execute immediately (for close/open commands)
  --dry-run           Show what would be done without executing
  --verbose           Show detailed output
  -h, --help          Show help for specific command

EXAMPLES:
  # Close all configured apps immediately
  mac-app-lifecycle close --now

  # Open whitelisted apps with verbose output
  mac-app-lifecycle open --now --verbose

  # Check launchd agent status
  mac-app-lifecycle status

  # View close-apps logs
  mac-app-lifecycle logs close

  # Dry-run to see what would happen
  mac-app-lifecycle close --now --dry-run

CONFIGURATION:
  Config files:  $CONFIG_DIR
  Log files:     $LOG_DIR
  Launch agents: ~/Library/LaunchAgents/

DOCUMENTATION:
  Installation:     docs/INSTALLATION.md
  Configuration:    docs/CONFIGURATION.md
  Troubleshooting:  docs/TROUBLESHOOTING.md

For more information, visit:
  https://github.com/yourusername/mac-app-lifecycle-manager
EOF
}

show_version() {
  echo "mac-app-lifecycle version ${VERSION}"
  echo "Copyright (c) 2026"
}

# =============================================================================
# COMMAND HANDLERS
# =============================================================================

handle_close() {
    local now=false
    local dry_run=false
    local verbose=false

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --now)
                now=true
                shift
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --verbose)
                verbose=true
                shift
                ;;
            *)
                echo "Error: Unknown option for close command: $1" >&2
                echo "Usage: mac-app-lifecycle close [--now] [--dry-run] [--verbose]" >&2
                exit 1
                ;;
        esac
    done

    # Validate config exists
    local config_file="$CONFIG_DIR/close-apps.conf"
    if [[ ! -f "$config_file" ]]; then
        echo "Error: Close-apps config not found: $config_file" >&2
        echo "Run: cp config/close-apps.conf.example config/close-apps.conf" >&2
        exit 3
    fi

    # Set environment variables for shell wrapper
    if [[ "$dry_run" == true ]]; then
        export DRY_RUN=1
    fi

    if [[ "$verbose" == true ]]; then
        export LOG_LEVEL=DEBUG
    fi

    # Execute the close-apps script
    echo "Executing close-apps script..."
    if "$SCRIPTS_DIR/close-apps/close-apps.sh"; then
        echo "Close-apps completed successfully"
    else
        local exit_code=$?
        echo "Close-apps failed with exit code: $exit_code" >&2
        exit 4
    fi
}

handle_open() {
    local now=false
    local dry_run=false
    local verbose=false

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --now)
                now=true
                shift
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --verbose)
                verbose=true
                shift
                ;;
            *)
                echo "Error: Unknown option for open command: $1" >&2
                echo "Usage: mac-app-lifecycle open [--now] [--dry-run] [--verbose]" >&2
                exit 1
                ;;
        esac
    done

    # Validate config exists
    local config_file="$CONFIG_DIR/open-apps.conf"
    if [[ ! -f "$config_file" ]]; then
        echo "Error: Open-apps config not found: $config_file" >&2
        echo "Run: cp config/open-apps.conf.example config/open-apps.conf" >&2
        exit 3
    fi

    # Set environment variables for shell wrapper
    if [[ "$dry_run" == true ]]; then
        export DRY_RUN=1
    fi

    if [[ "$verbose" == true ]]; then
        export LOG_LEVEL=DEBUG
    fi

    # Execute the open-apps script
    echo "Executing open-apps script..."
    if "$SCRIPTS_DIR/open-apps/open-apps.sh"; then
        echo "Open-apps completed successfully"
    else
        local exit_code=$?
        echo "Open-apps failed with exit code: $exit_code" >&2
        exit 4
    fi
}

handle_status() {
    echo "Phase 4.1: status command handler - Coming in Phase 4.3"
    echo "Arguments: $@"
    # TODO: Implement in Phase 4.3
}

handle_logs() {
    echo "Phase 4.1: logs command handler - Coming in Phase 4.4"
    echo "Arguments: $@"
    # TODO: Implement in Phase 4.4
}

# =============================================================================
# COMMAND PARSING
# =============================================================================

parse_command() {
    local command="$1"
    shift

    case "$command" in
        close)
            handle_close "$@"
            ;;
        open)
            handle_open "$@"
            ;;
        status)
            handle_status "$@"
            ;;
        logs)
            handle_logs "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        version|--version|-v)
            show_version
            ;;
        *)
            echo "Error: Unknown command '$command'" >&2
            echo "" >&2
            show_help >&2
            exit 1
            ;;
    esac
}

# =============================================================================
# MAIN
# =============================================================================

main() {
    # Validate installation first
    if ! validate_installation; then
        echo "Please run installation script or check configuration." >&2
        exit 2
    fi

    local command="${1:-}"

    if [[ -z "$command" ]]; then
        echo "Error: No command specified" >&2
        echo "" >&2
        show_help >&2
        exit 1
    fi

    # Parse and execute command
    parse_command "$@"
}

main "$@"
