#!/usr/bin/env bash
# mac-app-lifecycle - CLI tool for managing macOS application lifecycle
#
# Version: 0.0.13
# Phase 4.1: Core command structure with self-discovery

set -euo pipefail

# =============================================================================
# SELF-DISCOVERY MECHANISM
# =============================================================================

# Get script directory (works from any location)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Calculate repo root
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# Read version from package.json
PACKAGE_JSON="$REPO_ROOT/package.json"
if [[ -f "$PACKAGE_JSON" ]]; then
    VERSION=$(grep '"version"' "$PACKAGE_JSON" | head -1 | sed 's/.*"version": "\([^"]*\)".*/\1/')
else
    VERSION="unknown"
fi

# Set up all paths relative to repo root
CONFIG_DIR="$REPO_ROOT/config"
SCRIPTS_DIR="$REPO_ROOT/scripts"
LOG_DIR="$REPO_ROOT/logs"

# =============================================================================
# COLOR SUPPORT
# =============================================================================

# Color codes
if [[ -t 1 ]] && [[ -n "${TERM:-}" ]] && [[ "$TERM" != "dumb" ]]; then
    # Terminal supports colors
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    PURPLE='\033[0;35m'
    CYAN='\033[0;36m'
    WHITE='\033[1;37m'
    NC='\033[0m' # No Color
else
    # No color support
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    PURPLE=''
    CYAN=''
    WHITE=''
    NC=''
fi

# Colored output functions
error() {
    echo -e "${RED}Error:${NC} $*" >&2
}

warning() {
    echo -e "${YELLOW}Warning:${NC} $*" >&2
}

success() {
    echo -e "${GREEN}Success:${NC} $*"
}

info() {
    echo -e "${BLUE}Info:${NC} $*"
}

verbose() {
    local level="${1:-}"
    shift
    if [[ "$level" == "DEBUG" ]] || [[ "${LOG_LEVEL:-}" == "DEBUG" ]]; then
        echo -e "${PURPLE}Debug:${NC} $*"
    fi
}

# =============================================================================
# VALIDATION FUNCTIONS
# =============================================================================

validate_installation() {
    local errors=()

    verbose "DEBUG" "Validating installation..."

    # Check if config directory exists
    if [[ ! -d "$CONFIG_DIR" ]]; then
        errors+=("Config directory not found: $CONFIG_DIR")
        verbose "DEBUG" "Config directory check failed"
    else
        verbose "DEBUG" "Config directory exists: $CONFIG_DIR"
    fi

    # Check if scripts directory exists
    if [[ ! -d "$SCRIPTS_DIR" ]]; then
        errors+=("Scripts directory not found: $SCRIPTS_DIR")
        verbose "DEBUG" "Scripts directory check failed"
    else
        verbose "DEBUG" "Scripts directory exists: $SCRIPTS_DIR"
    fi

    # Check if log directory exists
    if [[ ! -d "$LOG_DIR" ]]; then
        errors+=("Log directory not found: $LOG_DIR")
        verbose "DEBUG" "Log directory check failed"
    else
        verbose "DEBUG" "Log directory exists: $LOG_DIR"
    fi

    # Check for required scripts
    local required_scripts=(
        "$SCRIPTS_DIR/close-apps/close-apps.sh"
        "$SCRIPTS_DIR/open-apps/open-apps.sh"
    )

    for script in "${required_scripts[@]}"; do
        if [[ ! -x "$script" ]]; then
            errors+=("Required script not executable: $script")
            verbose "DEBUG" "Script not executable: $script"
        else
            verbose "DEBUG" "Script is executable: $script"
        fi
    done

    # Check macOS version (basic check)
    if ! sw_vers >/dev/null 2>&1; then
        errors+=("This tool requires macOS")
        verbose "DEBUG" "macOS check failed"
    else
        verbose "DEBUG" "macOS detected"
    fi

    if [[ ${#errors[@]} -gt 0 ]]; then
        error "Installation validation failed:"
        for err in "${errors[@]}"; do
            echo "  - $err" >&2
        done
        echo "" >&2
        echo "Troubleshooting:" >&2
        echo "  1. Ensure you're running from the project root directory" >&2
        echo "  2. Check that all files are present: git status" >&2
        echo "  3. Make scripts executable: chmod +x scripts/**/*.sh" >&2
        echo "  4. See docs/TROUBLESHOOTING.md for more help" >&2
        return 1
    fi

    verbose "DEBUG" "Installation validation passed"
    return 0
}

# =============================================================================
# HELP & VERSION
# =============================================================================

show_help() {
  cat << EOF
mac-app-lifecycle - Automated macOS Application Lifecycle Manager

USAGE:
  mac-app-lifecycle <command> [options]

COMMANDS:
  close               Close configured applications
  open                Open whitelisted applications
  status              Show launchd agent status
  logs                Display recent logs
  help                Show this help message
  version             Show version information

OPTIONS:
  --now               Execute immediately (for close/open commands)
  --dry-run           Show what would be done without executing
  --verbose           Show detailed output
  -h, --help          Show help for specific command

EXAMPLES:
  # Close all configured apps immediately
  mac-app-lifecycle close --now

  # Open whitelisted apps with verbose output
  mac-app-lifecycle open --now --verbose

  # Check launchd agent status
  mac-app-lifecycle status

  # View close-apps logs
  mac-app-lifecycle logs close

  # Dry-run to see what would happen
  mac-app-lifecycle close --now --dry-run

CONFIGURATION:
  Config files:  $CONFIG_DIR
  Log files:     $LOG_DIR
  Launch agents: ~/Library/LaunchAgents/

DOCUMENTATION:
  Installation:     docs/INSTALLATION.md
  Configuration:    docs/CONFIGURATION.md
  Troubleshooting:  docs/TROUBLESHOOTING.md

For more information, visit:
  https://github.com/yourusername/mac-app-lifecycle-manager
EOF
}

show_version() {
  echo "mac-app-lifecycle version ${VERSION}"
  echo "Copyright (c) 2026"
}

# =============================================================================
# COMMAND HANDLERS
# =============================================================================

handle_close() {
    verbose "DEBUG" "Handling close command with args: $*"

    local now=false
    local dry_run=false
    local verbose=false

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --now)
                now=true
                verbose "DEBUG" "Now option enabled"
                shift
                ;;
            --dry-run)
                dry_run=true
                verbose "DEBUG" "Dry-run option enabled"
                shift
                ;;
            --verbose)
                verbose=true
                verbose "DEBUG" "Verbose option enabled"
                shift
                ;;
            *)
                error "Unknown option for close command: $1"
                echo "" >&2
                echo "Usage: mac-app-lifecycle close [--now] [--dry-run] [--verbose]" >&2
                echo "" >&2
                echo "Available options:" >&2
                echo "  --now      Execute immediately (default behavior)" >&2
                echo "  --dry-run  Show what would be done without executing" >&2
                echo "  --verbose  Show detailed output" >&2
                exit 1
                ;;
        esac
    done

    # Validate config exists
    local config_file="$CONFIG_DIR/close-apps.conf"
    if [[ ! -f "$config_file" ]]; then
        error "Close-apps config not found: $config_file"
        echo "" >&2
        echo "To fix this:" >&2
        echo "  cp config/close-apps.conf.example config/close-apps.conf" >&2
        echo "  # Then edit the config file as needed" >&2
        echo "" >&2
        echo "See docs/CONFIGURATION.md for configuration details." >&2
        exit 3
    fi

    # Check config file readability
    if [[ ! -r "$config_file" ]]; then
        error "Close-apps config file is not readable: $config_file"
        echo "Check file permissions: ls -la $config_file" >&2
        exit 3
    fi

    verbose "DEBUG" "Config file validated: $config_file"

    # Validate script exists and is executable
    local script_path="$SCRIPTS_DIR/close-apps/close-apps.sh"
    if [[ ! -f "$script_path" ]]; then
        error "Close-apps script not found: $script_path"
        echo "" >&2
        echo "This indicates an incomplete installation." >&2
        echo "Run the installation script or check the scripts directory." >&2
        exit 3
    fi

    if [[ ! -x "$script_path" ]]; then
        error "Close-apps script is not executable: $script_path"
        echo "Fix permissions: chmod +x $script_path" >&2
        exit 3
    fi

    verbose "DEBUG" "Script validated: $script_path"

    # Set environment variables for shell wrapper
    if [[ "$dry_run" == true ]]; then
        export DRY_RUN=1
        info "DRY RUN mode enabled - no actual changes will be made"
    fi

    if [[ "$verbose" == true ]]; then
        export LOG_LEVEL=DEBUG
        verbose "DEBUG" "Verbose logging enabled"
    fi

    # Execute the close-apps script
    verbose "DEBUG" "Executing script: $script_path"

    if [[ "$dry_run" == true ]]; then
        info "Executing close-apps script (dry-run)..."
    else
        info "Executing close-apps script..."
    fi

    if "$script_path"; then
        if [[ "$dry_run" == true ]]; then
            success "Close-apps dry-run completed successfully"
        else
            success "Close-apps completed successfully"
        fi
    else
        local exit_code=$?
        error "Close-apps failed with exit code: $exit_code"

        # Provide helpful error context
        echo "" >&2
        echo "Troubleshooting:" >&2
        if [[ "$dry_run" == true ]]; then
            echo "  - Dry-run failures usually indicate configuration issues" >&2
        else
            echo "  - Check the logs: mac-app-lifecycle logs close" >&2
            echo "  - Verify app configurations in: $config_file" >&2
        fi
        echo "  - See docs/TROUBLESHOOTING.md for more help" >&2

        exit 4
    fi
}

handle_open() {
    verbose "DEBUG" "Handling open command with args: $*"

    local now=false
    local dry_run=false
    local verbose=false

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --now)
                now=true
                verbose "DEBUG" "Now option enabled"
                shift
                ;;
            --dry-run)
                dry_run=true
                verbose "DEBUG" "Dry-run option enabled"
                shift
                ;;
            --verbose)
                verbose=true
                verbose "DEBUG" "Verbose option enabled"
                shift
                ;;
            *)
                error "Unknown option for open command: $1"
                echo "" >&2
                echo "Usage: mac-app-lifecycle open [--now] [--dry-run] [--verbose]" >&2
                echo "" >&2
                echo "Available options:" >&2
                echo "  --now      Execute immediately (default behavior)" >&2
                echo "  --dry-run  Show what would be done without executing" >&2
                echo "  --verbose  Show detailed output" >&2
                exit 1
                ;;
        esac
    done

    # Validate config exists
    local config_file="$CONFIG_DIR/open-apps.conf"
    if [[ ! -f "$config_file" ]]; then
        error "Open-apps config not found: $config_file"
        echo "" >&2
        echo "To fix this:" >&2
        echo "  cp config/open-apps.conf.example config/open-apps.conf" >&2
        echo "  # Then edit the config file as needed" >&2
        echo "" >&2
        echo "See docs/CONFIGURATION.md for configuration details." >&2
        exit 3
    fi

    # Check config file readability
    if [[ ! -r "$config_file" ]]; then
        error "Open-apps config file is not readable: $config_file"
        echo "Check file permissions: ls -la $config_file" >&2
        exit 3
    fi

    verbose "DEBUG" "Config file validated: $config_file"

    # Validate script exists and is executable
    local script_path="$SCRIPTS_DIR/open-apps/open-apps.sh"
    if [[ ! -f "$script_path" ]]; then
        error "Open-apps script not found: $script_path"
        echo "" >&2
        echo "This indicates an incomplete installation." >&2
        echo "Run the installation script or check the scripts directory." >&2
        exit 3
    fi

    if [[ ! -x "$script_path" ]]; then
        error "Open-apps script is not executable: $script_path"
        echo "Fix permissions: chmod +x $script_path" >&2
        exit 3
    fi

    verbose "DEBUG" "Script validated: $script_path"

    # Set environment variables for shell wrapper
    if [[ "$dry_run" == true ]]; then
        export DRY_RUN=1
        info "DRY RUN mode enabled - no actual changes will be made"
    fi

    if [[ "$verbose" == true ]]; then
        export LOG_LEVEL=DEBUG
        verbose "DEBUG" "Verbose logging enabled"
    fi

    # Execute the open-apps script
    verbose "DEBUG" "Executing script: $script_path"

    if [[ "$dry_run" == true ]]; then
        info "Executing open-apps script (dry-run)..."
    else
        info "Executing open-apps script..."
    fi

    if "$script_path"; then
        if [[ "$dry_run" == true ]]; then
            success "Open-apps dry-run completed successfully"
        else
            success "Open-apps completed successfully"
        fi
    else
        local exit_code=$?
        error "Open-apps failed with exit code: $exit_code"

        # Provide helpful error context
        echo "" >&2
        echo "Troubleshooting:" >&2
        if [[ "$dry_run" == true ]]; then
            echo "  - Dry-run failures usually indicate configuration issues" >&2
        else
            echo "  - Check the logs: mac-app-lifecycle logs open" >&2
            echo "  - Verify app configurations in: $config_file" >&2
        fi
        echo "  - See docs/TROUBLESHOOTING.md for more help" >&2

        exit 4
    fi
}

handle_status() {
    echo "mac-app-lifecycle Status"
    echo "========================"
    echo ""

    # Check close-apps agent
    echo "Close Apps Agent:"
    echo "  Label: com.user.mac-app-lifecycle.close"

    if launchctl list com.user.mac-app-lifecycle.close >/dev/null 2>&1; then
        echo "  Status: LOADED"
        # Could show PID if we parse the output, but for now just show loaded
    else
        echo "  Status: NOT LOADED"
    fi

    # Check plist file
    local close_plist="$HOME/Library/LaunchAgents/com.user.mac-app-lifecycle.close.plist"
    if [[ -f "$close_plist" ]]; then
        echo "  Plist: $close_plist"
    else
        echo "  Plist: Not installed"
    fi

    echo ""

    # Check open-apps agent
    echo "Open Apps Agent:"
    echo "  Label: com.user.mac-app-lifecycle.open"

    if launchctl list com.user.mac-app-lifecycle.open >/dev/null 2>&1; then
        echo "  Status: LOADED"
    else
        echo "  Status: NOT LOADED"
    fi

    # Check plist file
    local open_plist="$HOME/Library/LaunchAgents/com.user.mac-app-lifecycle.open.plist"
    if [[ -f "$open_plist" ]]; then
        echo "  Plist: $open_plist"
    else
        echo "  Plist: Not installed"
    fi

    echo ""
    echo "Note: Use install.sh/uninstall.sh scripts to load/unload agents"
    echo "      This command only shows current status"
}

handle_logs() {
    verbose "DEBUG" "Handling logs command with args: $*"

    local subcommand="${1:-}"

    case "$subcommand" in
        close)
            show_close_logs
            ;;
        open)
            show_open_logs
            ;;
        "")
            error "Please specify 'close' or 'open' logs"
            echo "Usage: mac-app-lifecycle logs <close|open>" >&2
            echo "" >&2
            echo "Available subcommands:" >&2
            echo "  close    Show close-apps logs" >&2
            echo "  open     Show open-apps logs" >&2
            echo "" >&2
            echo "Examples:" >&2
            echo "  mac-app-lifecycle logs close" >&2
            echo "  mac-app-lifecycle logs open" >&2
            exit 1
            ;;
        *)
            error "Unknown logs subcommand '$subcommand'"
            echo "Usage: mac-app-lifecycle logs <close|open>" >&2
            echo "" >&2
            echo "Available subcommands:" >&2
            echo "  close    Show close-apps logs" >&2
            echo "  open     Show open-apps logs" >&2
            exit 1
            ;;
    esac
}

show_close_logs() {
    verbose "DEBUG" "Showing close-apps logs"

    local log_file="$LOG_DIR/close-apps.log"

    echo "Close Apps Logs"
    echo "==============="
    echo "Log file: $log_file"
    echo ""

    if [[ -f "$log_file" ]]; then
        if [[ -r "$log_file" ]]; then
            if [[ -s "$log_file" ]]; then
                verbose "DEBUG" "Log file exists and has content"
                echo "Recent entries:"
                echo ""
                tail -20 "$log_file"
            else
                warning "Log file exists but is empty"
                echo "No log entries found. Run 'mac-app-lifecycle close' to generate logs." >&2
            fi
        else
            error "Log file is not readable: $log_file"
            echo "Check file permissions: ls -la $log_file" >&2
        fi
    else
        warning "Log file does not exist: $log_file"
        echo "Run 'mac-app-lifecycle close' to generate logs." >&2
    fi
}

show_open_logs() {
    verbose "DEBUG" "Showing open-apps logs"

    local log_file="$LOG_DIR/open-apps.log"

    echo "Open Apps Logs"
    echo "=============="
    echo "Log file: $log_file"
    echo ""

    if [[ -f "$log_file" ]]; then
        if [[ -r "$log_file" ]]; then
            if [[ -s "$log_file" ]]; then
                verbose "DEBUG" "Log file exists and has content"
                echo "Recent entries:"
                echo ""
                tail -20 "$log_file"
            else
                warning "Log file exists but is empty"
                echo "No log entries found. Run 'mac-app-lifecycle open' to generate logs." >&2
            fi
        else
            error "Log file is not readable: $log_file"
            echo "Check file permissions: ls -la $log_file" >&2
        fi
    else
        warning "Log file does not exist: $log_file"
        echo "Run 'mac-app-lifecycle open' to generate logs." >&2
    fi
}

# =============================================================================
# COMMAND PARSING
# =============================================================================

parse_command() {
    local command="$1"
    shift

    verbose "DEBUG" "Parsing command: $command"

    case "$command" in
        close)
            handle_close "$@"
            ;;
        open)
            handle_open "$@"
            ;;
        status)
            handle_status "$@"
            ;;
        logs)
            handle_logs "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        version|--version|-v)
            show_version
            ;;
        *)
            error "Unknown command: '$command'"
            echo "" >&2
            echo "Available commands:" >&2
            echo "  close    Close applications listed in config" >&2
            echo "  open     Open applications from whitelist" >&2
            echo "  status   Show current status of launchd agents" >&2
            echo "  logs     Show application logs" >&2
            echo "  help     Show this help message" >&2
            echo "  version  Show version information" >&2
            echo "" >&2
            echo "Run 'mac-app-lifecycle help' for detailed usage." >&2
            exit 1
            ;;
    esac
}

# =============================================================================
# MAIN
# =============================================================================

main() {
    # Set up error handling
    set -euo pipefail

    verbose "DEBUG" "Starting mac-app-lifecycle v$VERSION"

    # Validate installation first
    if ! validate_installation; then
        error "Installation validation failed"
        echo "" >&2
        echo "Troubleshooting:" >&2
        echo "  - Run the installation script: ./install.sh" >&2
        echo "  - Check configuration files in: $CONFIG_DIR" >&2
        echo "  - Verify script permissions: ls -la $SCRIPTS_DIR" >&2
        echo "  - See docs/INSTALLATION.md for setup instructions" >&2
        exit 2
    fi

    local command="${1:-}"

    if [[ -z "$command" ]]; then
        error "No command specified"
        echo "" >&2
        echo "Usage: mac-app-lifecycle <command> [options]" >&2
        echo "" >&2
        echo "Run 'mac-app-lifecycle help' for available commands." >&2
        exit 1
    fi

    # Parse and execute command
    parse_command "$@"
}

main "$@"
