# Environment variables for mac-app-lifecycle-manager
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Note: You can also set GITHUB_TOKEN in your shell profile (~/.zshrc)
# instead of using this file. The release script will use shell variables first.

# GitHub Personal Access Token for creating releases
# Generate at: https://github.com/settings/tokens
# Required scopes: repo
GITHUB_TOKEN=your_token_here
